{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TiviHub",
  "version": "2.1.2",
  "identifier": "nl.tivihub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "TiviHub",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "maximized": true,
        "decorations": false,
        "url": "app.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzOEM5QTkyMzZFRDY3QUYKUldTdlorMDJrcHFNQXdsS1BucmlaRTFOVGtxMzBXZFZmS2x5KzhYQW9CTXdKZjNxRGVxaGFkYmYK",
      "endpoints": [
        "https://github.com/TiviHub/TiviHub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
