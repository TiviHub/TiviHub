{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TiviHub",
  "version": "1.3.2",
  "identifier": "nl.tivihub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "TiviHub",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "url": "app.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
