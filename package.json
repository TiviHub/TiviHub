{
  "name": "tivihub",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "styleguide": "vite --open /styleguide.html",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build && node scripts/prerender-landing.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "pretest": "cargo build --quiet --manifest-path src-tauri/Cargo.toml --example storage_harness",
    "test": "vitest run src/__tests__",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:windows": "node scripts/package-windows.mjs",
    "package:unix": "node scripts/package-unix.mjs",
    "perf:build": "node scripts/perf/build-perf.mjs",
    "perf:data": "node scripts/perf/dataset.mjs",
    "perf:seed": "node scripts/perf/seed.mjs",
    "perf:baseline": "node scripts/perf/baseline.mjs",
    "perf:all": "node scripts/perf/all.mjs",
    "perf:a11y": "node scripts/perf/a11y.mjs",
    "perf:keyboard": "node scripts/perf/keyboard.mjs",
    "perf:credentials": "node scripts/perf/credential-scan.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "idb": "^8.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shaka-player": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
